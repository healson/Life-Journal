# --- 后端 ---
# JWT 签名密钥（生产务必改为足够长的随机串）
JWT_SECRET=please_change_this_to_a_long_random_string
# Token 有效期（分钟），默认 1440 = 24h
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 数据库连接；容器内使用挂载卷路径
DATABASE_URL=sqlite:////data/app.db
# 图片上传目录（Docker 下指向挂载卷以便持久化）
UPLOAD_DIR=/data/uploads

# --- AI 助手（可选，不配置则前端提示未启用）---
# DeepSeek API Key（https://platform.deepseek.com 创建）
AI_API_KEY=
# OpenAI 兼容接口地址（默认 DeepSeek，也可换成其他兼容服务）
AI_BASE_URL=https://api.deepseek.com
# 模型名称
AI_MODEL=deepseek-chat

# --- 自动定时备份（可选）---
# 备份时间（北京时间 HH:MM，默认 03:00）
BACKUP_TIME=03:00
# 备份周期：距最近一份快照满 N 天生成下一份（默认 1 = 每天），快照保留最近 10 份
BACKUP_INTERVAL_DAYS=1